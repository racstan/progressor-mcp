{
  "name": "progressor-mcp",
  "version": "0.5.1",
  "mcpName": "io.github.racstan/progressor-mcp",
  "description": "An MCP server that keeps an AI Agent and the Developer focused on their Goals across context compression and distractions.",
  "author": "Rachit Asthana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/racstan/progressor-mcp.git"
  },
  "homepage": "https://github.com/racstan/progressor-mcp#readme",
  "bugs": {
    "url": "https://github.com/racstan/progressor-mcp/issues"
  },
  "type": "module",
  "bin": {
    "progressor-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-ui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "dev:ui": "node scripts/build-ui.mjs --watch"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "planning",
    "progress"
  ],
  "license": "GPL-3.0-or-later",
  "funding": "https://buymeacoffee.com/rachitasthana",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
